% Grew Rules for CHILDES Parser Correction - Italian
% AS Sep 26
%
% Corrections for UDPipe model italian-isdt-ud-2.5
%   targeting mainly issues with spoken and incomplete language observed with CHILDES data
%
% Status: experimental - NOT yet run against a corpus
%
% Note: We log rule application in the Attribute "fix=<rule name>".
%       For fix= to be added to column MISC, the (default) configuration 'ud' is required.
%       see https://grew.fr/doc/conllu/#how-the-misc-field-is-handled-by-grew

% ============================================================
% Enclitics: division of labour with childes.py
% ============================================================
%
% childes.py (--split_enclitics) has already split verb+clitic forms into UD
% syntactic words and written the multiword-token line for them (mettilo -> 1-2
% mettilo / metti / lo). It marks the first word of each group Enclitic=A or
% Enclitic=B in MISC, so the group is identifiable here: the clitics are the
% nodes that directly follow that mark, at most two of them.
%
% Every clitic pattern below also requires textform="_" on C/C1/C2: linear
% adjacency (H < C, C1 < C2) alone is not enough to tell a genuine clitic from
% an ordinary word that happens to look like one right after a single-clitic
% host (dammi la casetta: "la" is casetta's article, not dammi's second
% clitic, but is adjacent and clitic-shaped). textform="_" is reliably true
% only for a non-initial member of an actual multiword split - childes.py's
% own clitic sub-tokens, and no ordinary standalone word - so it is what
% textform means here, not an incidental feature to leave out. Confirmed
% against grewpy: an unrelated adjacent "la" was being reassigned as a second
% clitic before this constraint was added.
%
% Why the split does not happen here, unlike French du/des: a fused enclitic form
% is out of vocabulary, so the parser returns an arbitrary analysis for it
% (lascialo, aiutami, mettici come back NOUN/ADJ; girati gets VerbForm=Part in
% both the imperative and the participle context). There is therefore no deprel
% to wait for, and the decision has to be taken before parsing.
%
% What is left for these rules is the part the parser gets wrong even on properly
% split input, checked against the UDPipe API: the accusative clitic is reliably
% obj, but the dative and reflexive ones are not (porta me lo -> me/nsubj,
% va te ne -> te/nsubj, fa mi vedere -> mi/obj, dir te lo -> te/expl). The clitic
% is also frequently attached to the wrong head. Both are repaired below.
%
% The deprels assigned follow the gold distribution in UD_Italian-ISDT (train+dev)
% and UD_Italian-PoSTWITA, counted over tokens with Clitic=Yes:
%   lo 97% obj    la 96% obj    li 97% obj    gli 100% iobj   glie 94% iobj
%   ne 88% iobj   si 61% expl (+18% expl:impers, +14% expl:pass)
%   le 58% obj / 41% iobj       mi 62% iobj / 19% obj / 17% expl
%   ti 50% obj / 30% iobj       ci 64% expl / 22% iobj / 11% obj
% Forms that are decided by their shape alone are assigned unconditionally; the
% rest are decided by position in the cluster, by the presence of a competing
% object, and only then by the verb's attested frames (italian-verbs.grewlex.tsv).
% Whatever remains genuinely undecided is marked todo= rather than guessed, so it
% can be counted and reviewed instead of silently entering the counts.

rule init_fix_misc {
  pattern { V [upos=VERB|AUX, !fix]; }
  commands { V.fix = ""; }
}

package clitici {

  % A clitic is identified by its form AND by sitting inside a multiword token,
  % i.e. directly after the node childes.py marked Enclitic=. It is deliberately
  % NOT identified by upos: the parser returns the wrong category often enough
  % (fagli -> gli/DET/det in this corpus) that requiring PRON would skip exactly
  % the cases these rules exist to repair. The category is set below instead.

  % ------------------------------------------------------------------
  % 1. Features and category.
  % ------------------------------------------------------------------
  rule clitic_features {
    pattern {
      H [Enclitic]; H < C;
      C [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\|[Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\|[Gg]li\)$", textform="_"];
    }
    without { C [Clitic="Yes", upos=PRON]; }
    commands {
      C.upos = PRON; C.xpos = "PC"; C.Clitic = "Yes"; C.PronType = "Prs";
      C.fix = clitic_features;
    }
  }

  rule clitic_features_second {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\)$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"];
    }
    without { C2 [Clitic="Yes", upos=PRON]; }
    commands {
      C2.upos = PRON; C2.xpos = "PC"; C2.Clitic = "Yes"; C2.PronType = "Prs";
      C2.fix = clitic_features;
    }
  }

  % ------------------------------------------------------------------
  % 2. Clusters. Italian clitic order is fixed - dative/reflexive before
  %    accusative/ne - so position decides, with no lexicon needed.
  %    Gold: glielo -> glie/iobj + lo/obj, diciamocela -> ce/iobj + la/obj.
  % ------------------------------------------------------------------
  rule cluster_second_obj {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\)$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\)$", textform="_"];
      e: X -> C2;
    }
    without { H -[obj]-> C2; }
    commands { del_edge e; add_edge H -[obj]-> C2; C2.fix = cluster_second_obj; }
  }

  rule cluster_second_ne {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\)$", textform="_"];
      C2 [form=re"^[Nn]e$", textform="_"];
      e: X -> C2;
    }
    without { H -[iobj]-> C2; }
    commands { del_edge e; add_edge H -[iobj]-> C2; C2.fix = cluster_second_ne; }
  }

  % first element of a cluster: reflexive si/se, otherwise dative
  rule cluster_first_refl {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^[Ss][ie]$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"];
      e: X -> C1;
    }
    without { H -[expl]-> C1; }
    commands { del_edge e; add_edge H -[expl]-> C1; C1.fix = cluster_first_refl; }
  }

  rule cluster_first_dat {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\)$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"];
      e: X -> C1;
    }
    without { H -[iobj]-> C1; }
    commands { del_edge e; add_edge H -[iobj]-> C1; C1.fix = cluster_first_dat; }
  }

  % ------------------------------------------------------------------
  % 3. Single clitics whose form decides the relation on its own.
  %    'without { C < C2 ... }' keeps these off the first element of a cluster,
  %    which rule group 2 has already handled.
  % ------------------------------------------------------------------
  rule single_acc {
    pattern {
      H [Enclitic]; H < C; C [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\)$", textform="_"]; e: X -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[obj]-> C; }
    commands { del_edge e; add_edge H -[obj]-> C; C.fix = single_acc; }
  }

  rule single_dat_gli {
    pattern {
      H [Enclitic]; H < C; C [form=re"^\([Gg]li\|[Gg]lie\)$", textform="_"]; e: X -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[iobj]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_dat_gli; }
  }

  rule single_ne {
    pattern {
      H [Enclitic]; H < C; C [form=re"^[Nn]e$", textform="_"]; e: X -> C;
    }
    without { H -[iobj]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_ne; }
  }

  rule single_refl_si {
    pattern {
      H [Enclitic]; H < C; C [form=re"^[Ss]i$", textform="_"]; e: X -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[1=expl]-> C; }
    commands { del_edge e; add_edge H -[expl]-> C; C.fix = single_refl_si; }
  }

  % ------------------------------------------------------------------
  % 4. Single mi/ti/ci/vi and le: not decided by form (gold: mi 62% iobj but
  %    ti 50% obj, le 58% obj / 41% iobj). A competing object settles it
  %    syntactically - 'dammi la palla', so mi can only be iobj; otherwise the
  %    verb's attested frames are consulted, and what they leave open is marked
  %    todo rather than guessed.
  % ------------------------------------------------------------------
  rule single_12_iobj_with_object {
    pattern {
      H [Enclitic, upos=VERB|AUX]; H < C; H -[obj]-> O;
      C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"];
      e: X -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[iobj]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_12_iobj_with_object; }
  }

  rule single_12_dative_verb (verbs from "italian-verbs.grewlex.tsv") {
    pattern {
      H [Enclitic, upos=VERB|AUX, lemma=verbs.lemma]; verbs.Iobj = "yes"; verbs.Obj = "no";
      H < C; C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"]; e: X -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[iobj]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_12_dative_verb; }
  }

  rule single_12_transitive_verb (verbs from "italian-verbs.grewlex.tsv") {
    pattern {
      H [Enclitic, upos=VERB|AUX, lemma=verbs.lemma]; verbs.Obj = "yes"; verbs.Iobj = "no";
      H < C; C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"]; e: X -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[obj]-> C; }
    commands { del_edge e; add_edge H -[obj]-> C; C.fix = single_12_transitive_verb; }
  }

  % Neither the syntax nor the lexicon decides: attach to the host so that the
  % tree is well formed, but say so. Count these before trusting any obj/iobj
  % ratio computed over 1st/2nd person clitics.
  rule single_12_undecided {
    pattern {
      H [Enclitic, upos=VERB|AUX]; H < C;
      C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"]; e: X -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { C [todo]; }
    without { H -[obj]-> O; }
    commands {
      del_edge e; add_edge H -[obj]-> C;
      C.fix = single_12_undecided; C.todo = "obj_or_iobj";
    }
  }
}

% ============================================================
% Enclitic host repair
% ============================================================
%
% childes.py's Tier A/B split correctly identifies the host, but the parser
% frequently mistags it - a fused enclitic form is out of vocabulary, and even
% split, some hosts (the geminated Tier A stems dam/dim/fam/dac/dic/fac/vac/stac,
% and short/rare regular imperatives) get too little training signal for the
% ISDT model to tag correctly (e.g. spegni -> DET, fate -> NOUN, dam -> NOUN).
% This package forces upos/xpos/FEATS from the host's own shape - the same
% information childes.py used to license the split in the first place - rather
% than leaving whatever wrong category the tagger guessed. Only touches hosts
% not already correctly tagged (guarded by upos=VERB, except ecco by upos=ADV),
% so already-correct parser output is never overwritten.
%
% Shape-based classification, each checked against gold ISDT/PoSTWITA/MarkIT/VIT/
% TWITTIRO/Old/ParTUT (7 treebanks):
%   ecco          -> ADV (never VERB; checked, 6/6 gold hits are ADV/INTJ)
%   ends in r     -> VERB, VerbForm=Inf (infinitive truncation: far/dar/dir/...)
%   ends in ando/endo -> VERB, VerbForm=Ger (full gerund, not truncated; 199 Ger
%                      vs 27 Conv in one other treebank's convention - using Ger,
%                      matching ISDT/PoSTWITA, which the rest of this file follows)
%   ends in [aei]te   -> VERB, Mood=Imp|Tense=Pres|Person=2|Number=Plur (2pl imperative)
%   ends in iamo      -> VERB, Mood=Imp|Tense=Pres|Person=1|Number=Plur (1pl imperative)
%   everything else   -> VERB, Mood=Imp|Tense=Pres|Person=2|Number=Sing (2sg imperative -
%                      Tier B is only ever imperative by childes.py's own construction;
%                      the other Tier A shapes, ecco/infinitive/gerund, are excluded above)
%
% Lemma is corrected only for the closed set of geminated/monosyllabic Tier A
% hosts (5 source verbs, unambiguous from the host string alone). Open-vocabulary
% Tier B hosts (spegni, metti, fate, ...) keep whatever lemma the tagger guessed -
% not recoverable here without a form->lemma dictionary, which this pipeline does
% not have.
%
% Runs before 'clitici' (see strat below): single_12_dative_verb/
% single_12_transitive_verb match H's lemma against the verb lexicon, which only
% works once H's lemma is corrected here.

package enclitic_host_repair {
  rule ecco_host {
    pattern { H [Enclitic, form=re"^[Ee]cco$"]; }
    without { H [upos=ADV] }
    commands {
      del_feat H.Mood; del_feat H.Gender; del_feat H.Number; del_feat H.PronType;
      del_feat H.Definite; del_feat H.Degree; del_feat H.Tense; del_feat H.Person; del_feat H.VerbForm;
      H.upos = ADV; H.xpos = "B"; H.fix = ecco_host;
    }
  }

  rule infinitive_host {
    pattern { H [Enclitic, form=re".*r$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.Number; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.VerbForm = "Inf"; H.fix = infinitive_host;
    }
  }

  rule gerund_host {
    pattern { H [Enclitic, form=re".*[ae]ndo$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.Number; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.VerbForm = "Ger"; H.fix = gerund_host;
    }
  }

  rule imperative_host_plural2 {
    pattern { H [Enclitic, form=re".*[aei]te$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.Mood = "Imp"; H.VerbForm = "Fin"; H.Tense = "Pres";
      H.Person = "2"; H.Number = "Plur"; H.fix = imperative_host_plural2;
    }
  }

  rule imperative_host_plural1 {
    pattern { H [Enclitic, form=re".*iamo$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.Mood = "Imp"; H.VerbForm = "Fin"; H.Tense = "Pres";
      H.Person = "1"; H.Number = "Plur"; H.fix = imperative_host_plural1;
    }
  }

  % Catch-all: by the time this runs (last in the sequence, see strat), every host
  % matching a more specific shape has already been converted to upos=VERB and is
  % therefore excluded by this same guard - no risk of misfiring on those.
  rule imperative_host_singular {
    pattern { H [Enclitic]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.Mood = "Imp"; H.VerbForm = "Fin"; H.Tense = "Pres";
      H.Person = "2"; H.Number = "Sing"; H.fix = imperative_host_singular;
    }
  }

  rule lemma_dare  { pattern { H [Enclitic, form=re"^\([Dd]am\|[Dd]ac\|[Dd]a\)$"]; } without { H [lemma="dare"]; } commands { H.lemma = "dare"; } }
  rule lemma_dire  { pattern { H [Enclitic, form=re"^\([Dd]im\|[Dd]ic\|[Dd]i\)$"]; } without { H [lemma="dire"]; } commands { H.lemma = "dire"; } }
  rule lemma_fare  { pattern { H [Enclitic, form=re"^\([Ff]am\|[Ff]ac\|[Ff]a\)$"]; } without { H [lemma="fare"]; } commands { H.lemma = "fare"; } }
  rule lemma_andare{ pattern { H [Enclitic, form=re"^\([Vv]ac\|[Vv]a\)$"]; } without { H [lemma="andare"]; } commands { H.lemma = "andare"; } }
  rule lemma_stare { pattern { H [Enclitic, form=re"^\([Ss]tac\|[Ss]ta\)$"]; } without { H [lemma="stare"]; } commands { H.lemma = "stare"; } }
}

% ============================================================
% strategy
% ============================================================

% Onf = One normal form (Apply rules repeatedly until stable)
% Alt = Try all rules in the list
strat main {
  Seq (
    Onf (enclitic_host_repair.ecco_host),
    Onf (enclitic_host_repair.infinitive_host),
    Onf (enclitic_host_repair.gerund_host),
    Onf (enclitic_host_repair.imperative_host_plural2),
    Onf (enclitic_host_repair.imperative_host_plural1),
    Onf (enclitic_host_repair.imperative_host_singular),
    Onf (Alt (enclitic_host_repair.lemma_dare, enclitic_host_repair.lemma_dire,
              enclitic_host_repair.lemma_fare, enclitic_host_repair.lemma_andare,
              enclitic_host_repair.lemma_stare)),
    Onf (Alt (
      init_fix_misc,
      clitici,
    ))
  )
}

% ============================================================
% lexicon
% ============================================================
