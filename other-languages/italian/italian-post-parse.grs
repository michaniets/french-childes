% Grew Rules for CHILDES Parser Correction - Italian
% AS Sep 26
%
% 1. Corrections for UDPipe parser models
%    - targeting issues with spoken and incomplete language observed with CHILDES data
% 2. Rewriting coupled to Italian UD conventions handled by childes.py v5.9
%    - targeting splitting and (re-)fusing of contracted Forms
%      verbs + enclitics, prepositions + determiners
%
% Note: We log rule application in the Attribute "fix=<rule name>".
%       For fix= to be added to column MISC, the (default) configuration 'ud' is required.
%       see https://grew.fr/doc/conllu/#how-the-misc-field-is-handled-by-grew
%
% ============================================================
% Enclitics: division of labour with childes.py
% ============================================================
%
% childes.py (--split_enclitics) has already split verb+clitic forms into UD
% syntactic words and written the multiword-token line for them (mettilo -> 1-2
% mettilo / metti / lo). It marks the first word of each group Enclitic=A or
% Enclitic=B in MISC, so the group is identifiable here: the clitics are the
% nodes that directly follow that mark, at most two of them.
%
% Every clitic pattern below also requires textform="_" on C/C1/C2: linear
% adjacency (H < C, C1 < C2) alone is not enough to tell a genuine clitic from
% an ordinary word that happens to look like one right after a single-clitic
% host (dammi la casetta: "la" is casetta's article, not dammi's second
% clitic, but is adjacent and clitic-shaped). textform="_" is reliably true
% only for a non-initial member of an actual multiword split - childes.py's
% own clitic sub-tokens, and no ordinary standalone word - so it is what
% textform means here, not an incidental feature to leave out. Confirmed
% against grewpy: an unrelated adjacent "la" was being reassigned as a second
% clitic before this constraint was added.
%
% Why the split does not happen here, unlike French du/des: a fused enclitic form
% is out of vocabulary, so the parser returns an arbitrary analysis for it
% (lascialo, aiutami, mettici come back NOUN/ADJ; girati gets VerbForm=Part in
% both the imperative and the participle context). There is therefore no deprel
% to wait for, and the decision has to be taken before parsing.
%
% What is left for these rules is the part the parser gets wrong even on properly
% split input, checked against the UDPipe API: the accusative clitic is reliably
% obj, but the dative and reflexive ones are not (porta me lo -> me/nsubj,
% va te ne -> te/nsubj, fa mi vedere -> mi/obj, dir te lo -> te/expl). The clitic
% is also frequently attached to the wrong head. Both are repaired below.
%
% The deprels assigned follow the gold distribution in UD_Italian-ISDT (train+dev)
% and UD_Italian-PoSTWITA, counted over tokens with Clitic=Yes:
%   lo 97% obj    la 96% obj    li 97% obj    gli 100% iobj   glie 94% iobj
%   ne 88% iobj   si 61% expl (+18% expl:impers, +14% expl:pass)
%   le 58% obj / 41% iobj       mi 62% iobj / 19% obj / 17% expl
%   ti 50% obj / 30% iobj       ci 64% expl / 22% iobj / 11% obj
% Forms that are decided by their shape alone are assigned unconditionally; the
% rest are decided by position in the cluster, by the presence of a competing
% object, and only then by the verb's attested frames (italian-verbs.grewlex.tsv).
% Whatever remains genuinely undecided is marked todo= rather than guessed, so it
% can be counted and reviewed instead of silently entering the counts.

% NB: the value must not be empty. An empty MISC value (fix=) makes Grew drop
% the ENTIRE MISC field of that node when the file is read back, so Enclitic=
% becomes invisible and every rule below silently stops matching on re-runs.
rule init_fix_misc {
  pattern { V [upos=VERB|AUX, !fix]; }
  commands { V.fix = "none"; }
}

package clitici {

  % A clitic is identified by its form AND by sitting inside a multiword token,
  % i.e. directly after the node childes.py marked Enclitic=. It is deliberately
  % NOT identified by upos: the parser returns the wrong category often enough
  % (fagli -> gli/DET/det in this corpus) that requiring PRON would skip exactly
  % the cases these rules exist to repair. The category is set below instead.

  % ------------------------------------------------------------------
  % 1. Features and category.
  % ------------------------------------------------------------------
  rule clitic_features {
    pattern {
      H [Enclitic]; H < C;
      C [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\|[Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\|[Gg]li\)$", textform="_"];
    }
    without { C [Clitic="Yes", upos=PRON]; }
    commands {
      C.upos = PRON; C.xpos = "PC"; C.Clitic = "Yes"; C.PronType = "Prs";
      C.fix = clitic_features;
    }
  }

  rule clitic_features_second {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\)$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"];
    }
    without { C2 [Clitic="Yes", upos=PRON]; }
    commands {
      C2.upos = PRON; C2.xpos = "PC"; C2.Clitic = "Yes"; C2.PronType = "Prs";
      C2.fix = clitic_features;
    }
  }

  % ------------------------------------------------------------------
  % 2. Clusters. Italian clitic order is fixed - dative/reflexive before
  %    accusative/ne - so position decides, with no lexicon needed.
  %    Gold: glielo -> glie/iobj + lo/obj, diciamocela -> ce/iobj + la/obj.
  % ------------------------------------------------------------------
  rule cluster_second_obj {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\)$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\)$", textform="_"];
      e: H -> C2;
    }
    without { H -[obj]-> C2; }
    commands { del_edge e; add_edge H -[obj]-> C2; C2.fix = cluster_second_obj; }
  }

  rule cluster_second_ne {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Ss]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ss]i\)$", textform="_"];
      C2 [form=re"^[Nn]e$", textform="_"];
      e: H -> C2;
    }
    without { H -[iobj]-> C2; }
    commands { del_edge e; add_edge H -[iobj]-> C2; C2.fix = cluster_second_ne; }
  }

  % first element of a cluster: reflexive si/se, otherwise dative
  rule cluster_first_refl {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^[Ss][ie]$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"];
      e: H -> C1;
    }
    without { H -[expl]-> C1; }
    commands { del_edge e; add_edge H -[expl]-> C1; C1.fix = cluster_first_refl; }
  }

  rule cluster_first_dat {
    pattern {
      H [Enclitic]; H < C1; C1 < C2;
      C1 [form=re"^\([Mm]e\|[Tt]e\|[Cc]e\|[Vv]e\|[Gg]lie\|[Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\)$", textform="_"];
      C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"];
      e: H -> C1;
    }
    without { H -[iobj]-> C1; }
    commands { del_edge e; add_edge H -[iobj]-> C1; C1.fix = cluster_first_dat; }
  }

  % ------------------------------------------------------------------
  % 3. Single clitics whose form decides the relation on its own.
  %    'without { C < C2 ... }' keeps these off the first element of a cluster,
  %    which rule group 2 has already handled.
  % ------------------------------------------------------------------
  rule single_acc {
    pattern {
      H [Enclitic]; H < C; C [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\)$", textform="_"]; e: H -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[obj]-> C; }
    commands { del_edge e; add_edge H -[obj]-> C; C.fix = single_acc; }
  }

  rule single_dat_gli {
    pattern {
      H [Enclitic]; H < C; C [form=re"^\([Gg]li\|[Gg]lie\)$", textform="_"]; e: H -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[iobj]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_dat_gli; }
  }

  rule single_ne {
    pattern {
      H [Enclitic]; H < C; C [form=re"^[Nn]e$", textform="_"]; e: H -> C;
    }
    without { H -[iobj]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_ne; }
  }

  rule single_refl_si {
    pattern {
      H [Enclitic]; H < C; C [form=re"^[Ss]i$", textform="_"]; e: H -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[1=expl]-> C; }
    commands { del_edge e; add_edge H -[expl]-> C; C.fix = single_refl_si; }
  }

  % ------------------------------------------------------------------
  % 4. Single mi/ti/ci/vi and le: not decided by form (gold: mi 62% iobj but
  %    ti 50% obj, le 58% obj / 41% iobj). A competing object settles it
  %    syntactically - 'dammi la palla', so mi can only be iobj; otherwise the
  %    verb's attested frames are consulted, and what they leave open is marked
  %    todo rather than guessed.
  % ------------------------------------------------------------------
  rule single_12_iobj_with_object {
    pattern {
      H [Enclitic, upos=VERB|AUX]; H < C; H -[obj]-> O; O [upos=NOUN|PROPN];
      C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"];
      e: H -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[iobj]-> C; }
    % keep an expl the parser asserted: ti/ci/vi of a pronominal verb
    without { H -[expl]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_12_iobj_with_object; }
  }

  rule single_12_dative_verb (verbs from "italian-verbs.grewlex.tsv") {
    pattern {
      H [Enclitic, upos=VERB|AUX, lemma=verbs.lemma]; verbs.Iobj = "yes"; verbs.Obj = "no";
      H < C; C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"]; e: H -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[iobj]-> C; }
    % keep an expl the parser asserted: ti/ci/vi of a pronominal verb
    without { H -[expl]-> C; }
    commands { del_edge e; add_edge H -[iobj]-> C; C.fix = single_12_dative_verb; }
  }

  rule single_12_transitive_verb (verbs from "italian-verbs.grewlex.tsv") {
    pattern {
      H [Enclitic, upos=VERB|AUX, lemma=verbs.lemma]; verbs.Obj = "yes"; verbs.Iobj = "no";
      H < C; C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"]; e: H -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { H -[obj]-> C; }
    % keep an expl the parser asserted: ti/ci/vi of a pronominal verb
    without { H -[expl]-> C; }
    % A competing object settles the case syntactically, so single_12_iobj_with_object
    % above decides it and this rule must stand back. Without this guard the two
    % alternate forever - each only checks the relation it assigns itself, so iobj
    % re-enables obj and obj re-enables iobj (10000-step abort on Antelmi,
    % Calambrone). Same guard as single_12_undecided.
    without { H -[obj]-> O; O [upos=NOUN|PROPN]; }
    commands { del_edge e; add_edge H -[obj]-> C; C.fix = single_12_transitive_verb; }
  }

  % Neither the syntax nor the lexicon decides: attach to the host so that the
  % tree is well formed, but say so. Count these before trusting any obj/iobj
  % ratio computed over 1st/2nd person clitics.
  % ecco is a presentative, not a verb: UD makes its clitic an expletive, not an
  % object (ISDT+PoSTWITA: expl in 4 of 4 - lo x2, ci, le). Runs after the rules
  % above rather than guarding each of them, so it simply overrides whatever they
  % assigned; the expl guard terminates it.
  rule ecco_clitic {
    pattern {
      H [Enclitic, form=re"^\([Ee]cco\)$"]; C [textform="_"]; H << C; e: H -> C;
    }
    without { H -[expl]-> C; }
    commands { del_edge e; add_edge H -[expl]-> C; C.fix = ecco_clitic; }
  }

  rule single_12_undecided {
    pattern {
      H [Enclitic, upos=VERB|AUX]; H < C;
      C [form=re"^\([Mm]i\|[Tt]i\|[Cc]i\|[Vv]i\|[Ll]e\)$", textform="_"]; e: H -> C;
    }
    without { C < C2; C2 [form=re"^\([Ll]o\|[Ll]a\|[Ll]i\|[Ll]e\|[Nn]e\)$", textform="_"]; }
    without { C [todo]; }
    % never overwrite a decision another rule already made (Alt gives no order)
    without { H -[obj]-> C; }
    without { H -[iobj]-> C; }
    % must mirror single_12_iobj_with_object's guard exactly: if the competing
    % object is not a real NP that rule stays silent, so this one must speak,
    % otherwise the clitic keeps the 'dep' placeholder and is never labelled.
    without { H -[obj]-> O; O [upos=NOUN|PROPN]; }
    % keep an expl the parser asserted: ti/ci/vi of a pronominal verb
    without { H -[expl]-> C; }
    commands {
      del_edge e; add_edge H -[obj]-> C;
      C.fix = single_12_undecided; C.todo = "obj_or_iobj";
    }
  }
}

% ============================================================
% Enclitic host repair
% ============================================================
%
% childes.py's Tier A/B split correctly identifies the host, but the parser
% frequently mistags it - a fused enclitic form is out of vocabulary, and even
% split, some hosts (the geminated Tier A stems dam/dim/fam/dac/dic/fac/vac/stac,
% and short/rare regular imperatives) get too little training signal for the
% ISDT model to tag correctly (e.g. spegni -> DET, fate -> NOUN, dam -> NOUN).
% This package forces upos/xpos/FEATS from the host's own shape - the same
% information childes.py used to license the split in the first place - rather
% than leaving whatever wrong category the tagger guessed. Only touches hosts
% not already correctly tagged (guarded by upos=VERB, except ecco by upos=ADV),
% so already-correct parser output is never overwritten.
%
% Shape-based classification, each checked against gold ISDT/PoSTWITA/MarkIT/VIT/
% TWITTIRO/Old/ParTUT (7 treebanks):
%   ecco          -> ADV (never VERB; checked, 6/6 gold hits are ADV/INTJ)
%   ends in r     -> VERB, VerbForm=Inf (infinitive truncation: far/dar/dir/...)
%   ends in ando/endo -> VERB, VerbForm=Ger (full gerund, not truncated; 199 Ger
%                      vs 27 Conv in one other treebank's convention - using Ger,
%                      matching ISDT/PoSTWITA, which the rest of this file follows)
%   ends in [aei]te   -> VERB, Mood=Imp|Tense=Pres|Person=2|Number=Plur (2pl imperative)
%   ends in iamo      -> VERB, Mood=Imp|Tense=Pres|Person=1|Number=Plur (1pl imperative)
%   everything else   -> VERB, Mood=Imp|Tense=Pres|Person=2|Number=Sing (2sg imperative -
%                      Tier B is only ever imperative by childes.py's own construction;
%                      the other Tier A shapes, ecco/infinitive/gerund, are excluded above)
%
% Lemma is corrected only for the closed set of geminated/monosyllabic Tier A
% hosts (5 source verbs, unambiguous from the host string alone). Open-vocabulary
% Tier B hosts (spegni, metti, fate, ...) keep whatever lemma the tagger guessed -
% not recoverable here without a form->lemma dictionary, which this pipeline does
% not have.
%
% Runs before 'clitici' (see strat below): single_12_dative_verb/
% single_12_transitive_verb match H's lemma against the verb lexicon, which only
% works once H's lemma is corrected here.

package enclitic_host_repair {
  rule ecco_host {
    pattern { H [Enclitic, form=re"^[Ee]cco$"]; }
    without { H [upos=ADV] }
    commands {
      del_feat H.Mood; del_feat H.Gender; del_feat H.Number; del_feat H.PronType;
      del_feat H.Definite; del_feat H.Degree; del_feat H.Tense; del_feat H.Person; del_feat H.VerbForm;
      H.upos = ADV; H.xpos = "B"; H.fix = ecco_host;
    }
  }

  rule infinitive_host {
    pattern { H [Enclitic, form=re".*r$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.Number; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.VerbForm = "Inf"; H.fix = infinitive_host;
    }
  }

  rule gerund_host {
    pattern { H [Enclitic, form=re".*[ae]ndo$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.Number; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.VerbForm = "Ger"; H.fix = gerund_host;
    }
  }

  rule imperative_host_plural2 {
    pattern { H [Enclitic, form=re".*[aei]te$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.Mood = "Imp"; H.VerbForm = "Fin"; H.Tense = "Pres";
      H.Person = "2"; H.Number = "Plur"; H.fix = imperative_host_plural2;
    }
  }

  rule imperative_host_plural1 {
    pattern { H [Enclitic, form=re".*iamo$"]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    commands {
      del_feat H.Gender; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.Mood = "Imp"; H.VerbForm = "Fin"; H.Tense = "Pres";
      H.Person = "1"; H.Number = "Plur"; H.fix = imperative_host_plural1;
    }
  }

  % Catch-all: by the time this runs (last in the sequence, see strat), every host
  % matching a more specific shape has already been converted to upos=VERB and is
  % therefore excluded by this same guard - no risk of misfiring on those.
  rule imperative_host_singular {
    pattern { H [Enclitic]; }
    without { H [upos=VERB] }
    without { H [fix]; }
    % ecco is the one Tier A host that is not a verb. When the parser already
    % tags it ADV, ecco_host above correctly does nothing - which leaves no fix=
    % marker to protect it, so this catch-all would clobber a correct analysis
    % into a VERB imperative (31 of 53 ecco hosts in Roma).
    without { H [form=re"^\([Ee]cco\)$"]; }
    commands {
      del_feat H.Gender; del_feat H.PronType; del_feat H.Definite; del_feat H.Degree;
      H.upos = VERB; H.xpos = "V"; H.Mood = "Imp"; H.VerbForm = "Fin"; H.Tense = "Pres";
      H.Person = "2"; H.Number = "Sing"; H.fix = imperative_host_singular;
    }
  }

  rule lemma_dare  { pattern { H [Enclitic, form=re"^\([Dd]am\|[Dd]ac\|[Dd]a\)$"]; } without { H [lemma="dare"]; } commands { H.lemma = "dare"; } }
  rule lemma_dire  { pattern { H [Enclitic, form=re"^\([Dd]im\|[Dd]ic\|[Dd]i\)$"]; } without { H [lemma="dire"]; } commands { H.lemma = "dire"; } }
  rule lemma_fare  { pattern { H [Enclitic, form=re"^\([Ff]am\|[Ff]ac\|[Ff]a\)$"]; } without { H [lemma="fare"]; } commands { H.lemma = "fare"; } }
  rule lemma_andare{ pattern { H [Enclitic, form=re"^\([Vv]ac\|[Vv]a\)$"]; } without { H [lemma="andare"]; } commands { H.lemma = "andare"; } }
  rule lemma_stare { pattern { H [Enclitic, form=re"^\([Ss]tac\|[Ss]ta\)$"]; } without { H [lemma="stare"]; } commands { H.lemma = "stare"; } }
}

% ============================================================
% strategy
% ============================================================

% Onf = One normal form (Apply rules repeatedly until stable)
% Alt = Try all rules in the list
% ============================================================
% Normalise the attachment of split clitics before anything else.
%
% Grew matches injectively: in "e: X -> C" the identifier X can never bind to H.
% Every rule in 'clitici' therefore used to be unreachable whenever the parser
% attached the clitic to its own host (48% of real cases) or made it the root
% (18%) - measured on Roma. Forcing each clitic of a split multiword token onto
% its host first lets those rules match "e: H -> C" and reach every case.
%
% Only fires where the attachment is actually wrong: reattach_* needs a governor
% other than H (injectivity), reattach_root_* needs no H->C edge to exist. A
% clitic already hanging off its host is left alone, label and all.
% ============================================================
package clitic_reattach {
  rule reattach_single {
    pattern { H [Enclitic]; C [textform="_"]; H < C; e: X -> C; }
    commands { del_edge e; add_edge H -[dep]-> C; }
  }
  rule reattach_second {
    pattern { H [Enclitic]; C1 [textform="_"]; C2 [textform="_"]; H < C1; C1 < C2; e: X -> C2; }
    commands { del_edge e; add_edge H -[dep]-> C2; }
  }
  rule reattach_root_single {
    pattern { H [Enclitic]; C [textform="_"]; H < C; }
    without { H -> C; }
    commands { add_edge H -[dep]-> C; }
  }
  rule reattach_root_second {
    pattern { H [Enclitic]; C1 [textform="_"]; C2 [textform="_"]; H < C1; C1 < C2; }
    without { H -> C2; }
    commands { add_edge H -[dep]-> C2; }
  }
}

% ============================================================
% Preposizioni articolate (al, nella, del, ...)
%
% Only 'di' also forms the partitive article, so di-forms are ambiguous between
% a single DET (Max legge dei libri) and ADP+DET (il gusto del pane), and are
% submitted to the parser FUSED so that it can decide - measured in ISDT: a split
% form heads an obj in 1 of 15814 cases (0.01%), an unsplit partitive in 57% of
% 75, and fusing gets both readings right. a/in/su/con (and the unambiguous dal,
% dall') never form a partitive; left fused the parser loses the preposition and
% reads the noun as a core argument, so childes.py pre-splits them.
%
% These rules restore the UD-conformant surface from the deprel, which is exactly
% what the tokenizer could not know:
%   pre-split a/in/su/con/da  -> re-fuse as a multiword token (analysis was right)
%   di-form, head noun nmod/obl* -> expand to di + article (multiword token)
%   di-form, head noun obj/nsubj -> partitive article, leave as a single DET
% Each rule logs in 'fix' on the node it changes.
%
% The dare-homographs dai/dallo/dalla/dalle/dagli are never pre-split (see
% IT_CONTRACTIONS_VETOED in childes.py), so they arrive fused and are left alone
% here: in child language they are overwhelmingly the verb, not the contraction.
% ============================================================
package amalgami {

  % An intransitive verb has no direct object, so a di-form "object" is a di-PP.
  % Relabelling to obl:arg also lets split_di below apply on the next pass.
  rule di_verb_complement (verbs from "italian-verbs.grewlex.tsv") {
    pattern {
      V [upos=VERB|AUX, lemma=verbs.lemma]; verbs.Obj = "no";
      N []; D [form=re"^\([Dd]el\|[Dd]ello\|[Dd]ella\|[Dd]ell'\|[Dd]ei\|[Dd]egli\|[Dd]elle\)$", upos=DET];
      N -[det]-> D;
      e: V -[obj]-> N;
    }
    without { N -[1=case]-> C; }   % already marked by another preposition
    commands {
      del_edge e; add_edge V -[obl:arg]-> N; V.fix = di_verb_complement;
    }
  }

  % --- when is a di-form the preposition rather than the partitive article? ---
  %
  % Deprel alone is too weak here: child-language parses put the head noun of a
  % genitive on nsubj/obj/root often enough that the PP rule below missed 11 of
  % 11 real cases in Roma. Two much stronger signals, measured on ISDT+PoSTWITA:
  %
  %   preceded by a nominal : prep+art 7687 vs partitive 6  (NOUN), ADJ 1038 vs 0
  %   head noun singular    : prep+art 51.8%, partitive 7.1% - and every singular
  %                           partitive in the gold data is a mass noun (acqua,
  %                           farina, male, rumore, gente), never a count noun.
  %
  % So: a nominal to the left, or a singular non-mass head, means preposition.
  % What is left fused - a plural or mass head after a verb - is the partitive
  % (legge dei libri, c'è dell'acqua), which UD keeps as one DET.
  %
  % The governor is matched with a bare edge, not -[det]->, and the fused form's
  % upos is not constrained: the parser mistags it as ADJ/PRON/NOUN in 4 of those
  % 11 cases, but still hangs it off the right noun.

  rule split_di_after_nominal (amalg from "italian-amalgami.grewlex.tsv") {
    pattern {
      amalg.kind = "split";
      D [form=amalg.fused];
      N []; e0: N -> D; D << N;
      L [upos=NOUN|PROPN|ADJ|NUM]; L < D;
    }
    commands {
      add_node P :< D;
      P.form = amalg.prep; P.lemma = "di"; P.upos = ADP; P.xpos = "E";
      P.textform = amalg.fused; P.wordform = amalg.prep;
      D.form = amalg.art; D.lemma = "il"; D.upos = DET; D.xpos = "RD";
      D.textform = "_"; D.wordform = amalg.art; D.Definite = "Def";
      add_edge N -[case]-> P;
      del_edge e0; add_edge N -[det]-> D;
      D.fix = split_di_after_nominal;
    }
  }

  rule split_di_count_noun (amalg from "italian-amalgami.grewlex.tsv") {
    pattern {
      amalg.kind = "split";
      D [form=amalg.fused];
      N [upos=NOUN|PROPN|PRON|ADJ|NUM, Number=Sing]; e0: N -> D; D << N;
    }
    without { N [lemma=re"^\\(acqua\\|pane\\|latte\\|sale\\|zucchero\\|farina\\|gente\\|roba\\|carne\\|frutta\\|verdura\\|pasta\\|minestra\\|pappa\\|brodo\\|olio\\|burro\\|formaggio\\|riso\\|caffè\\|tè\\|vino\\|birra\\|sabbia\\|terra\\|neve\\|pioggia\\|male\\|bene\\|rumore\\|cioccolata\\|marmellata\\|miele\\|succo\\|sugo\\|aria\\|fumo\\|fuoco\\|luce\\|musica\\|tempo\\|denaro\\|carta\\|plastica\\|legno\\|ferro\\|oro\\|erba\\|colla\\|pipì\\|cacca\\|altro\\|tutto\\)$"]; }   % mass nouns can be partitive when singular
    commands {
      add_node P :< D;
      P.form = amalg.prep; P.lemma = "di"; P.upos = ADP; P.xpos = "E";
      P.textform = amalg.fused; P.wordform = amalg.prep;
      D.form = amalg.art; D.lemma = "il"; D.upos = DET; D.xpos = "RD";
      D.textform = "_"; D.wordform = amalg.art; D.Definite = "Def";
      add_edge N -[case]-> P;
      del_edge e0; add_edge N -[det]-> D;
      D.fix = split_di_count_noun;
    }
  }

  % last resort: the deprel says PP or genitive
  rule split_di_pp (amalg from "italian-amalgami.grewlex.tsv") {
    pattern {
      amalg.kind = "split";
      D [form=amalg.fused];
      N []; e0: N -> D; D << N;
      X -[1=nmod|obl]-> N;
    }
    without { N -[1=case]-> C; }
    commands {
      add_node P :< D;
      P.form = amalg.prep; P.lemma = "di"; P.upos = ADP; P.xpos = "E";
      P.textform = amalg.fused; P.wordform = amalg.prep;
      D.form = amalg.art; D.lemma = "il"; D.upos = DET; D.xpos = "RD";
      D.textform = "_"; D.wordform = amalg.art; D.Definite = "Def";
      add_edge N -[case]-> P;
      del_edge e0; add_edge N -[det]-> D;
      D.fix = split_di_pp;
    }
  }

  % Pre-split a/da/in/su/con + article: restore the fused surface as a multiword
  % token. The analysis is already right; only the surface differs.
  %
  % Matched on the Amalgama= mark childes.py wrote, NOT on the forms: modern
  % Italian writes 'con il/la' uncontracted (1147 occurrences in this corpus
  % against 508 'col'), so a form-based rule would rewrite a genuine 'con la' as
  % 'colla' - which is also the noun 'glue'. Only what we split is re-fused, so
  % an uncontracted sequence the child actually produced stays as transcribed.
  % The mark also carries the original capitalisation, and deleting it
  % terminates the rule.
  rule fuse_contraction {
    pattern { P [Amalgama]; D []; P < D; }
    commands {
      P.textform = P.Amalgama; D.textform = "_";
      del_feat P.Amalgama; P.fix = fuse_contraction;
    }
  }
}

% ============================================================
% Cyclic graphs
%
% The parser sometimes makes the enclitic host a dependent of one of its own
% clitics (ecco -advmod-> le, da -case-> me). The rules below then hang the
% clitics off the host, closing a cycle: the sentence has no root and anything
% that builds a tree from it fails, so it silently disappears from the HTML
% export - 25 of 115 enclitic multiword tokens in one Roma run.
%
% The repair is to promote the host into the clitic's slot: shift_in moves the
% clitic's governors onto the host, labels included, so the host inherits the
% position the whole group should occupy, and the clitic then hangs off the
% host. If the clitic was the sentence root, the host becomes the root.
%
% Both clitic positions are needed: promoting over the first can leave the host
% governed by the second (dammelo: da -case-> me -nmod-> lo), and the cluster
% rules would close the cycle again. The break_cycle rules matter only when
% already-rewritten output is processed a second time, where the cycle arrives
% fully formed and shift_in would otherwise retarget an edge into a self-loop
% and leave the clitic with two governors.
%
% Note this cannot rescue a file whose root was already lost: if no node carries
% head=0 there is nothing to promote anyone into. Such files must be regenerated
% from the .cha source.
% ============================================================
package cycle_repair {
  rule break_cycle {
    pattern { H [Enclitic]; C [textform="_"]; H < C; C -> H; e: H -> C; }
    commands { del_edge e; }
  }

  rule break_cycle_second {
    pattern { H [Enclitic]; C1 [textform="_"]; C2 [textform="_"]; H < C1; C1 < C2;
              C2 -> H; e: H -> C2; }
    commands { del_edge e; }
  }

  rule host_promote {
    pattern { H [Enclitic]; C [textform="_"]; H < C; e: C -> H; }
    commands { del_edge e; shift_in C ==> H; add_edge H -[dep]-> C; }
  }

  rule host_promote_second {
    pattern { H [Enclitic]; C1 [textform="_"]; C2 [textform="_"]; H < C1; C1 < C2;
              e: C2 -> H; }
    commands { del_edge e; shift_in C2 ==> H; add_edge H -[dep]-> C2; }
  }
}

strat main {
  Seq (
    Onf (enclitic_host_repair.ecco_host),
    Onf (enclitic_host_repair.infinitive_host),
    Onf (enclitic_host_repair.gerund_host),
    Onf (enclitic_host_repair.imperative_host_plural2),
    Onf (enclitic_host_repair.imperative_host_plural1),
    Onf (enclitic_host_repair.imperative_host_singular),
    Onf (Alt (enclitic_host_repair.lemma_dare, enclitic_host_repair.lemma_dire,
              enclitic_host_repair.lemma_fare, enclitic_host_repair.lemma_andare,
              enclitic_host_repair.lemma_stare)),
    % before the clitics are re-attached, so the host is already in the right
    % slot when they are hung off it
    Onf (Alt (cycle_repair.break_cycle, cycle_repair.break_cycle_second,
              cycle_repair.host_promote, cycle_repair.host_promote_second)),
    Onf (clitic_reattach.reattach_single),
    Onf (clitic_reattach.reattach_second),
    Onf (clitic_reattach.reattach_root_single),
    Onf (clitic_reattach.reattach_root_second),
    % single_12_undecided is a catch-all: it must run only after every deciding
    % rule has converged, otherwise Alt's unspecified order lets it claim cases
    % the lexicon or the syntax could have decided, and stamp them todo=.
    Onf (Alt (
      init_fix_misc,
      clitici.clitic_features,
      clitici.clitic_features_second,
      clitici.cluster_second_obj,
      clitici.cluster_second_ne,
      clitici.cluster_first_refl,
      clitici.cluster_first_dat,
      clitici.single_acc,
      clitici.single_dat_gli,
      clitici.single_ne,
      clitici.single_refl_si,
      clitici.single_12_iobj_with_object,
      clitici.single_12_dative_verb,
      clitici.single_12_transitive_verb,
    )),
    Onf (clitici.single_12_undecided),
    Onf (clitici.ecco_clitic),
    % contractions: relabel first, so split_di sees the corrected deprel, and
    % re-fuse last (it must not see the pair split_di has just created - it
    % cannot, since 'di' is absent from the kind=fuse rows of the lexicon).
    Onf (amalgami.di_verb_complement),
    Onf (amalgami.split_di_after_nominal),
    Onf (amalgami.split_di_count_noun),
    Onf (amalgami.split_di_pp),
    Onf (amalgami.fuse_contraction)
  )
}

